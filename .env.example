# ── Gemini（只在 Next.js 伺服器端使用，不會送到瀏覽器）──────────────
GEMINI_API_KEY=your_google_ai_studio_api_key
GEMINI_MODEL=gemini-2.5-flash
# 主模型失敗時依序改用（逗號分隔，可省略）
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-flash-latest
# GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe

# ── Safety Gateway（正式服務：python -m safety_gateway.server，預設 8765）──
SAFETY_GATEWAY_URL=http://127.0.0.1:8765
# Next 與 Gateway 兩邊要設成同一把（至少 16 字元）。本機開發可留空；
# GATEWAY_ENV=production 時 Gateway 會強制要求。
# SAFETY_GATEWAY_TOKEN=
# GATEWAY_ENV=development

# Gateway 沒開時是否退回陽春的本機規則（僅開發用，production 一律忽略）。
# 預設 false：Gateway 失聯就拒絕服務，不會把未檢查的內容送給模型。
# SAFETY_ALLOW_LOCAL_FALLBACK=false

# ── 速率限制（每 IP 每分鐘；可省略，使用預設）─────────────────────
# RATE_LIMIT_INSPECT_PER_MIN=90
# RATE_LIMIT_IMAGE_PER_MIN=10
# RATE_LIMIT_CHAT_PER_MIN=30
# RATE_LIMIT_VOICE_PER_MIN=20
# RATE_LIMIT_WRITING_PER_MIN=30

# Gateway 端的全域上限（所有請求都來自 Next，所以這是整體後盾，不是每人額度；
# 同時使用的孩子變多時請調高）。
# GATEWAY_INSPECT_PER_MINUTE=600
# GATEWAY_IMAGE_PER_MINUTE=30

# ── Playground（開發／內部測試用，預設 8766，不要對外）──────────────
# PLAYGROUND_SHARE_PASSWORD=
