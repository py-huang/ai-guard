# ── Gemini（只在 Next.js 伺服器端使用，不會送到瀏覽器）──────────────
GEMINI_API_KEY=your_google_ai_studio_api_key
GEMINI_MODEL=gemini-2.5-flash
# 主模型失敗時依序改用（逗號分隔，可省略）
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-flash-latest
# GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe

# ── Safety Gateway（正式服務：python -m safety_gateway.server，預設 8765）──
SAFETY_GATEWAY_URL=http://127.0.0.1:8765
# Next 與 Gateway 兩邊要設成同一把（至少 16 字元）。本機開發可留空；
# GATEWAY_ENV=production 時 Gateway 會強制要求。
# SAFETY_GATEWAY_TOKEN=
# GATEWAY_ENV=development

# Gateway 沒開時是否退回陽春的本機規則（僅開發用，production 一律忽略）。
# 預設 false：Gateway 失聯就拒絕服務，不會把未檢查的內容送給模型。
# SAFETY_ALLOW_LOCAL_FALLBACK=false

# ── 速率限制（每 IP 每分鐘；可省略，使用預設）─────────────────────
# RATE_LIMIT_INSPECT_PER_MIN=90
# RATE_LIMIT_IMAGE_PER_MIN=10
# RATE_LIMIT_CHAT_PER_MIN=30
# RATE_LIMIT_VOICE_PER_MIN=20
# RATE_LIMIT_WRITING_PER_MIN=30

# Gateway 端的全域上限（所有請求都來自 Next，所以這是整體後盾，不是每人額度；
# 同時使用的孩子變多時請調高）。
# GATEWAY_INSPECT_PER_MINUTE=600
# GATEWAY_IMAGE_PER_MINUTE=30

# ── 手錶語音通話紀錄（家長端看得到的通話）──────────────────────────
# local  ：存在瀏覽器（localStorage），只有同一個瀏覽器的家長頁面看得到。預設，不需要後端。
# sqlite ：存在這台伺服器的檔案資料庫，家長可以在別的裝置查看。使用 Node 內建的 node:sqlite，
#          需要 Node 22.5 以上；目前仍標示為實驗性，只適合單機展示。
#          只會存遮蔽後的文字，不存原始個資，也不錄音。
#
# 配對（不用自己設定密碼）：
#   sqlite 模式第一次啟動時，伺服器會自動產生一組隨機密碼，存在資料庫旁的 parent-token 檔
#   （資料夾已被 git 忽略，重啟後不變），並在終端機印出配對網址和 QR code。
#   家長用手機掃一次就好，之後瀏覽器會記住，不用登入。密碼放在網址的 # 後面，
#   瀏覽器不會把它送到伺服器，開啟後也會立刻從網址列清掉。
#   想換掉密碼：刪除 parent-token 檔後重啟，所有裝置要重新配對。
#   手機連不到時（例如在 Docker 或要走 HTTPS 網域），用 PARENT_PAIR_BASE_URL 指定家長開啟的網址。
#   正式環境的 log 是共用的，所以預設不印出配對網址；需要時設 PARENT_PAIR_PRINT=1。
#   也可以自己指定 PARENT_API_TOKEN（至少 16 個字元，太短會被忽略），例如用密碼管理器產生。
#   注意：在沒有 HTTPS 的區域網路上，密碼會以明文傳輸；要在網際網路上使用請一定要走 HTTPS。
#
# 自動過期：
#   通話紀錄超過 VOICE_RECORD_RETENTION_DAYS 天就刪除（預設 30，0 表示不自動刪除）。
#   伺服器每小時清理一次，讀取和寫入時也會檢查；家長手機上的副本會跟著同步過期。
# VOICE_RECORD_STORE=local
# VOICE_RECORD_RETENTION_DAYS=30
# PARENT_API_TOKEN=
# PARENT_PAIR_BASE_URL=
# PARENT_PAIR_PRINT=
# VOICE_RECORD_DB_PATH=data/voice-records.db
# VOICE_RECORD_MAX_SESSIONS=500
# RATE_LIMIT_RECORDS_PER_MIN=120

# ── Playground（開發／內部測試用，預設 8766，不要對外）──────────────
# PLAYGROUND_SHARE_PASSWORD=
